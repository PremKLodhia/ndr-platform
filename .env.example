# ==============================================================================
# NDR Platform Environment Configuration Example
# Copy this file to .env and replace placeholders with real credentials.
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# General Configuration
NDR_ENV=development
NDR_LOG_LEVEL=INFO
NDR_FAIL_SECURE_MODE=true

# OPNsense Firewall API Settings
OPNSENSE_API_HOST=https://192.168.1.1
OPNSENSE_API_KEY=your_opnsense_api_key_here
OPNSENSE_API_SECRET=your_opnsense_api_secret_here
OPNSENSE_VERIFY_SSL=false
OPNSENSE_QUARANTINE_VLAN_ID=99
OPNSENSE_BLOCK_RULE_TABLE=ndr_blocked_ips

# SIEM / Wazuh / ELK Integration
WAZUH_MANAGER_HOST=127.0.0.1
WAZUH_MANAGER_PORT=1514
WAZUH_API_USER=wazuh_api_user
WAZUH_API_PASSWORD=wazuh_api_password
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme

# Pipeline & Model Paths
MODEL_CLASSIFIER_PATH=models/xgboost_flow_classifier.json
MODEL_ANOMALY_PATH=models/autoencoder_benign.pt
FEATURE_SCALER_PATH=models/feature_scaler.joblib
